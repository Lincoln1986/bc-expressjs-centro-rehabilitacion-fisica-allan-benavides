# Test Environment Variables
# Semana 09: Testing con Jest + Supertest

NODE_ENV=test
PORT=3000

# MongoDB — se usa mongodb-memory-server en tests
# MONGODB_URI se ignora en tests (se usa MongoMemoryServer)

# JWT — secretos para testing (NO usar en producción)
JWT_ACCESS_SECRET=test-access-secret-for-jest-only-must-be-long-enough
JWT_REFRESH_SECRET=test-refresh-secret-for-jest-only-must-be-long-enough
