{
  "name": "week05-rehabilitacion-prisma",
  "version": "1.0.0",
  "description": "Week 05 — API with PostgreSQL + Prisma ORM for Centro de Rehabilitación Física",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "express": "5.1.0",
    "morgan": "1.10.0",
    "winston": "3.17.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/morgan": "1.9.10",
    "@types/node": "22.15.21",
    "prisma": "6.8.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
