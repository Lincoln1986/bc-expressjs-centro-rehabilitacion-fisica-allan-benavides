// Prisma Schema — Centro de Rehabilitación Física
// Semana 05: PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo secundario: Terapeutas
model Therapist {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  specialty String
  email     String    @unique
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relación 1:N — Un terapeuta tiene muchas sesiones
  sessions Session[]
}

// Modelo principal: Sesiones de rehabilitación
model Session {
  id            String   @id @default(uuid()) @db.Uuid
  patientName   String
  category      String
  exercise      String
  price         Float
  active        Boolean  @default(true)
  scheduledAt   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // FK a Therapist
  therapistId String @db.Uuid
  therapist   Therapist @relation(fields: [therapistId], references: [id])
}
